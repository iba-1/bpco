# Local development environment (dev only — never for production).
# Exoscale deployment values are set by the CI/deploy pipeline, not this file.
# Copy to backend/.env

PORT=3000
REDIRECT_URI=bpco://callback

# Verne Gate (ADR-0003) — set real values when integrating auth (T03)
VERNE_GATE_BASE_URL=
VERNE_GATE_CLIENT_ID=

# Session JWT — generate a random value locally; the deploy pipeline injects it
SESSION_SECRET=
SESSION_TTL_SECONDS=604800